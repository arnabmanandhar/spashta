# Copy to .env for local runs (.env is git-ignored). On a host, put these in its
# secrets / environment settings instead, never in a committed file.

# Only one model key is needed, and only if you want the LLM claim review.
# Use a free-tier key with no billing attached so a leak can't cost money.
GEMINI_API_KEY=
# GROQ_API_KEY=

# Long random string; enables POST /api/sources and /api/ingest.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SPASHTA_ADMIN_TOKEN=

# Public safety settings (defaults shown)
SPASHTA_PUBLIC_LLM=0
SPASHTA_LLM_DAILY_LIMIT=50
SPASHTA_RATE_PER_MIN=20
SPASHTA_GLOBAL_RATE_PER_MIN=120
SPASHTA_TRUST_PROXY=1
SPASHTA_REQUEST_TIMEOUT=30
SPASHTA_MAX_CONCURRENT=4
SPASHTA_MAX_BODY_BYTES=262144
SPASHTA_LOG_LEVEL=INFO

SPASHTA_DB=spashta.db
SPASHTA_EMBEDDER=hashing
